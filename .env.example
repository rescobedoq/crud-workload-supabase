# Copia este archivo como .env y reemplaza los valores por los de Supabase.
PORT=3000

# Usa los datos exactos de Supabase > Connect > Connection string.
# Para Session pooler, el usuario normalmente incluye el project ref.
PGHOST=aws-0-region.pooler.supabase.com
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres.PROJECT_REF
PGPASSWORD=REEMPLAZA_CON_TU_CONTRASENA
PGSSL=true
